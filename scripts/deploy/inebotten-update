#!/usr/bin/env bash
set -euo pipefail

REPO="${INEBOTTEN_REPO:-/opt/inebotten-discord}"
BRANCH="${INEBOTTEN_BRANCH:-master}"
LOG="${INEBOTTEN_UPDATE_LOG:-/var/log/inebotten-autoupdate.log}"
LOCK="${INEBOTTEN_UPDATE_LOCK:-/run/inebotten-update.lock}"
PYTHON="${INEBOTTEN_PYTHON:-python3}"
PROFILE="${INEBOTTEN_DEPLOY_PROFILE:-compose}"

exec 9>"$LOCK"
if ! flock -n 9; then
  echo "Update already running" >> "$LOG"
  exit 0
fi

{
  cd "$REPO"
  if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
    echo "dirty_source: checkout preserved; service not changed"
    exit 1
  fi
  # Source sync must succeed before any Docker or service action. Never reset WIP.
  git fetch origin "$BRANCH"
  git merge --ff-only "origin/$BRANCH"
  commit_full="$(git rev-parse HEAD)"
  if [[ ! "$commit_full" =~ ^[0-9a-f]{40}$ ]]; then
    echo "invalid_source_revision"
    exit 1
  fi
  echo "Preparing full revision $commit_full"
  "$PYTHON" scripts/inebotten_deploy.py --repo "$REPO" --profile "$PROFILE" --build --apply
  echo "Verified deployment at $commit_full"
} >> "$LOG" 2>&1
